{
  "name": "@skill-shelf/desktop",
  "version": "0.1.2",
  "private": true,
  "description": "A local-first desktop GUI for skills.sh",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev --watch",
    "dist": "pnpm run build && electron-builder --config electron-builder.release.mjs --publish never",
    "pack": "pnpm run build && electron-builder --dir",
    "test": "vitest run",
    "test:release": "node --test release-config.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.30",
    "@skill-shelf/i18n": "workspace:*",
    "@skill-shelf/ui": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "7.0.66",
    "electron-updater": "^6.8.9",
    "lucide-react": "1.31.0",
    "node-pty": "^1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "skills": "1.5.23",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
