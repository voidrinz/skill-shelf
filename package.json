{
  "name": "skill-shelf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @skill-shelf/desktop --filter @skill-shelf/website dev",
    "dev:desktop": "pnpm --filter @skill-shelf/desktop dev",
    "dev:website": "pnpm --filter @skill-shelf/website dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:generate": "node scripts/generate-icons.mjs",
    "pack:desktop": "pnpm --filter @skill-shelf/desktop run pack",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "2.5.20",
    "prettier-plugin-tailwindcss": "0.6.14",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
